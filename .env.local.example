# 复制本文件为 .env.local 并填入真实值。.env.local 已被 .gitignore 忽略，不会进 git。

# ── 后端讯飞 MaaS API（server.js 用，密钥不再暴露给浏览器）──
# 格式：APIKey:APISecret（讯飞 MaaS 控制台获取）
IFLYTEK_API_KEY=your_api_key:your_api_secret
IFLYTEK_API_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2/chat/completions
IFLYTEK_MODEL=astron-code-latest

# ── 课件图片生成（server.js 用，三条线路按需配；缺哪条哪条线路不可用）──
# line1 GPT Image-2（BananaRouter）。不填则「GPT」线路不可用
IMAGE_API_KEY=
# line2 讯飞星火 TTI（讯飞控制台获取 appid + key + secret）
XF_TTI_APP_ID=
XF_TTI_API_KEY=
XF_TTI_API_SECRET=
# line3 豆包 Seedream（火山方舟 API Key）
DOUBAO_API_KEY=

# ── iron-session 密钥（≥32 字符）──
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SMART_TEACHING_SESSION_PASSWORD=replace_with_a_random_48_byte_base64_string
# HTTPS 站点经 HTTP 反代时设为 false，纯本地开发也设 false
SMART_TEACHING_COOKIE_SECURE=false

# ── 接入 admin-hub 时由后台读取的数据库路径（可选，默认 ./data/smart-teaching.db）──
# SMART_TEACHING_DB_PATH=

# ── API 服务端口（与 vite.config.js 的 proxy target 对应）──
PORT=4701

# ── 课件用户白名单校验（登录时调 admin-hub gate 接口）──
# 登录手机号需在 admin-hub「课件用户」名单且为启用状态，否则拒绝登录。
# admin-hub gate 接口地址：本机 http://localhost:3001/b100/api/teaching/gate
#                          生产 http://127.0.0.1:3004/b100/api/teaching/gate
TEACHING_GATE_URL=http://localhost:3001/b100/api/teaching/gate
# 与 admin-hub 的 TEACHING_GATE_SECRET 必须完全一致（建议 hex，避免 dotenv 对 $ 的展开）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEACHING_GATE_SECRET=
